# Copy this file to backend/.env for manual development.
# Replace YOUR_PASSWORD with the Supabase database password. URL-encode any
# special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres.nwfvvlnfzrupazeruovk:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Local PDF settings. Use an absolute persistent-disk path in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# Optional, e.g. https://your-api.onrender.com. Blank works for same-origin use.
PUBLIC_BASE_URL=
